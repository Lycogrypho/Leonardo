    class "_Test" <<case>> [[developer.html]] {
        + kind: TestKind   (ttest / confint / chisqtest)
        p-value as 2*cdf(-|t|), never 2*(1-cdf(|t|))
    }

    enum "StatKind" <<data>> [[developer.html]] {
        mean variance pvariance
        stddev pstddev
    }
    enum "PairStatKind" <<data>> [[developer.html]] {
        covariance   correlation
    }
    enum "TestKind" <<data>> [[developer.html]] {
        ttest   confint   chisqtest
    }

    "_Statistic"     ..> "Descriptive"
    "_Statistic"     ..> "StatKind"
    "_PairStatistic" ..> "Descriptive"
    "_PairStatistic" ..> "PairStatKind"
    "_Regress"       ..> "Regression"
    "_Test"          ..> "Descriptive"
    "_Test"          ..> "TestKind"
    "_Statistic"     ..> "Moments" : distribution arg -> probability.Moments
}

package "probability" <<Rectangle>> {

    class "_Distribution" <<value>> [[developer.html]] {
        + kind: DistKind
        + params: Vector[Double]
        + pdf / cdf / mean / variance / probability
        __ companion __
        + of(kind, params): Option   VALIDATES; invalid -> stays symbolic
        a _Value, but cheap to add: nothing has to
        read it AS a number (contrast _Rational)
    }

    enum "DistKind" <<data>> [[developer.html]] {
        Normal  Uniform  Exponential
        Binomial  Poisson
        StudentT  ChiSquared   (added by 4.Q)
    }

    enum "Query" <<data>> [[developer.html]] {
        Pdf  Cdf  Prob  Quantile
    }

    class "_DistributionOf" <<case>> [[developer.html]] {
        symbolic constructor: normal(m, s)
        evals to _Distribution once params are numeric
    }

    class "_DistributionQuery" <<case>> [[developer.html]] {
        query: Query   (pdf / cdf / prob / quantile)
    }

    class "Predicate" <<utility>> [[developer.html]] {
        prob(X < 2): predicate form (4.R slice B)
        reads a comparison as Bounds; the random
        variable is the one name bound to a _Distribution
    }

    class "_Expectation" <<case>> [[developer.html]] {
        expect(e, X)  or  expect(d)
        X is a BINDER (excluded from children)
    }

    class "_Variance" <<case>> [[developer.html]]

    class "Moments" <<object>> [[developer.html]] {
        linearity rule table (Derive.scala's shape)
        E[a+b]=E[a]+E[b]   E[cX]=cE[X]   Var(aX+b)=a^2 Var(X)
        isConstant: NOT merely "free of X" --
        another random variable is not a constant
    }

    "_Distribution"      ..|> "_Value"
    "_Distribution"      ..>  "DistKind"
    "_DistributionOf"    ..>  "_Distribution" : eval
    "_DistributionQuery" ..>  "_Distribution" : pdf/cdf/quantile
    "_DistributionQuery" ..>  "Query"
    "_DistributionQuery" ..>  "Predicate"     : prob(X < c) form
    "_Expectation"       ..>  "Moments"
    "_Variance"          ..>  "Moments"
}
package "parser" {
    class "Parser" <<object>> [[getting-started.html]] {
        + parse(str: String): ParseResult
        + ReservedWords: Set
        __ __
        MaxDepth = 500
        variable ::= [a-zA-Z][a-zA-Z0-9]*
        exact mode: literal -> _Rational (Option[Int])
    }
}

