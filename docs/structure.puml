@startuml

' Layout engine: Graphviz dot (default).
' If dot is not on PATH, set GRAPHVIZ_DOT before running `sbt puml`
' or add `!pragma layout smetana` here to use the built-in pure-Java engine
' (smetana does NOT support clickable [[url]] links in SVG).

!define DIAGRAM_WIDTH 12000
!define DIAGRAM_HEIGHT 8000
skinparam defaultFontName Courier

skinparam packageStyle rectangle
skinparam classAttributeIconSize 0
skinparam shadowing false
' Colour legend (by stereotype):
'   <<case>>    AST node classes (_Expression subtypes)   - green
'   <<value>>   concrete value carriers (_Value)          - amber
'   <<utility>> / <<object>> / <<main>>  algorithm modules - blue
'   <<data>>    ancillary: enums, config, data helpers    - grey
'   <<trait>>   traits / interfaces                        - pale yellow
skinparam class {
    BackgroundColor White
    BorderColor      #555577
    ArrowColor       #444466
    FontName         Monospaced
    BackgroundColor<<case>>    #E6F4EA
    BorderColor<<case>>        #4C9A63
    BackgroundColor<<value>>   #FBEBD0
    BorderColor<<value>>       #C9963B
    BackgroundColor<<utility>> #E1ECFB
    BorderColor<<utility>>     #5B7FBF
    BackgroundColor<<object>>  #E1ECFB
    BorderColor<<object>>      #5B7FBF
    BackgroundColor<<main>>    #D6E0F5
    BorderColor<<main>>        #5B7FBF
    BackgroundColor<<data>>    #ECECEC
    BorderColor<<data>>        #999999
}
skinparam package {
    BackgroundColor  #F4F4FF
    BorderColor      #7777AA
    FontStyle        Bold
}
skinparam interface {
    BackgroundColor  #FFFBE6
    BorderColor      #AAAA55
}

hide empty members

' ===================================================
' PACKAGE: core
' Foundation shared by every domain.
' ===================================================
package "core" {

    interface "_Expression" <<trait>> [[expressions.html]] {
        + eval(env: Environment): Either
        + children: List
        + rebuild(cs: List): _Expression
        + freeVars: Set
    }

    interface "_Value" <<trait>> [[expressions.html]]

    interface "_ElementWise" <<trait>> [[expressions.html]]

    interface "_MatrixShaped" <<trait>> [[matrix.html]] {
        + rows: Int
        + cols: Int
    }

    class "_Number" <<value>> [[expressions.html]] {
        + d: Double
        + display(precision: Int): String
    }

    class "_Bool" <<value>> [[expressions.html]] {
        + b: Boolean
    }

    class "_Truth" <<value>> [[logic.html]] {
        + d: Double   (strictly inside 0..1)
        + display(precision: Int): String
        __ companion __
        + of(d): _Value  (0.0 -> _Bool(false), 1.0 -> _Bool(true))
        Unknown: _Truth = _Truth(0.5)
        + fromSymmetric(s): _Value   t = (s + 1) / 2
        + toSymmetric(v): Option[Double]
        display: "unknown" at 0.5, else "truth(d)"
    }

    class "_Complex" <<value>> [[equations.html]] {
        + re: Double
        + im: Double
        + display(precision: Int): String
        __ companion __
        + of(re, im): _Value  (im==0 -> _Number)
        + add/sub/mul/div/pow
        + expc/logc/sinc/cosc/tanc
    }

    class "_Rational" <<value>> [[developer.html]] {
        + num: BigInt   (carries the sign)
        + den: BigInt   (always > 0, may be unreduced)
        + add/subtract/multiply/divide/pow  (each takes a GcdPolicy)
        + approximate(maxDen): _Rational
        + approximateToDigits(digits): _Rational
        + maxBitLength: Int
        __ companion __
        + of(n, d, policy): Option[_Rational]
        + fromDouble(d): Option[_Rational]  (exact dyadic)
        DefaultPolicy = Threshold(256)      chosen by the 4.M benchmark
        + thresholdFor(digits) = max(256, 8 * digits)
        sibling _Value of _Number (issue 4.L)
        transcendentals via spire Real (core/Irrational)
        _Number.unapply WIDENS to match this too:
        case _Number(x) means: reads as real x
        equality by cross-multiplication: 2/6 == 1/3
    }

    enum "GcdPolicy" <<data>> [[developer.html]] {
        Eager             reduce on every construction
        Lazy              never reduce (rejected by 4.M)
        Threshold(maxBits) reduce past a bound (CHOSEN)
    }

    class "_Based" <<value>> [[developer.html]] {
        + value: Long
        + base: Int    (2..36)
        + balanced: Boolean
        __ companion __
        + of(value, base, balanced): _Value
          base 10 / non-int / radix outside 2..36 -> _Number
        fourth sibling of _Number (3.5); the base
        lives on the VALUE so 0xFF still prints FF.
        tag is SHALLOW: 0xFF + 1 -> 256 (decimal)
        toString: 0x.. / 0b.. / 0o.. / 0t.. / tobase(n,b)
    }

    enum "LogicSemantics" <<data>> [[logic.html]] {
        MinMax        min / max            (default)
        Product       a*b / a+b-a*b
        Lukasiewicz   max(0,a+b-1) / min(1,a+b)
        the fuzzy t-norm/t-conorm family (issue 4.H)
    }

    class "_Variable" <<case>> [[expressions.html]] {
        + variable: String
    }

    class "_MatrixValue" <<value>> [[matrix.html]] {
        + rows: Int
        + cols: Int
        - data: Array[Double]
        + toVector: Vector[Double]
        + display(precision: Int): String
        + add(that): _MatrixValue
        + multiply(that): _MatrixValue
        + transpose: _MatrixValue
        + scale(k: Double): _MatrixValue
        + determinant: Option[Double]
        + inverse: Option[_MatrixValue]
        + luDecompose: Option[(L, U, P)]
        + qrDecompose: Option[(Q, R)]
        + eigenDecompose: Option[Vector[_Value]]
        + spectralDecompose: Option[(Vector[Vector[_Value]], Vector[_Value])]
        + kronecker(that): _MatrixValue
        + vec: _MatrixValue
        + guarded(orElse): Either
        __ companion __
        + apply(rows, cols, data) : defensive copy
        + identity(n): _MatrixValue
        + unvec(v, rows, cols): Option[_MatrixValue]
    }

    class "Environment" <<data>> [[expressions.html]] {
        + precision: Int   (display)
        + workingPrecision: Int  (exact tier; default 30)
        + symmetricLogic: Boolean  (truth-value encoding)
        + semantics: LogicSemantics  (t-norm family)
        + get(name: String): Option
        + withBinding(name, v): Environment
        __ companion __
        DefaultPrecision: Int = 5
        DefaultWorkingPrecision: Int = 30
    }

    "_Value"        --|> "_Expression"
    "_ElementWise"  --|> "_Expression"
    "_MatrixShaped" --|> "_Expression"
    "_Number"      ..|> "_Value"
    "_Bool"        ..|> "_Value"
    "_Truth"       ..|> "_Value"
    "_Complex"     ..|> "_Value"
    "_MatrixValue" ..|> "_Value"
    "_Variable"    ..|> "_Expression"
    "_Rational"    ..|> "_Value"
    "_Based"       ..|> "_Value"
    "_Rational"    ..>  "GcdPolicy"    : reduction policy per operation
    "_Rational"    ..>  "Environment"  : workingPrecision + rationalPolicy
    "Environment"  ..>  "LogicSemantics" : t-norm family field

    class "_Heaviside" <<case>> [[expressions.html]] {
        + arg: _Expression
        + eval: 0 or 1 when arg is _Number; symbolic otherwise
        + toString: "step(arg)"
    }
    "_Heaviside"   ..|> "_Expression"

    "_Expression"  --> "Environment" : eval(env)
}

' ===================================================
' PACKAGE: scalar - AST nodes
' ===================================================
package "scalar" {

    ' -- Operations ---------------------------------
    interface "_Operation" <<trait>> [[expressions.html]]

    class "Sum" <<case>> [[expressions.html]] {
        a : _Expression
        b : _Expression
    }
    class "Product" <<case>> [[expressions.html]] {
        a : _Expression
        b : _Expression
    }
    class "Ratio" <<case>> [[expressions.html]] {
        a : _Expression
        b : _Expression
    }
    class "Power" <<case>> [[expressions.html]] {
        base : _Expression
        exp  : _Expression
    }

    "_Operation" --|> "_Expression"
    "Sum"        --|> "_Operation"
    "Product"    --|> "_Operation"
    "Ratio"      --|> "_Operation"
    "Power"      --|> "_Operation"

    ' -- Unary Functions ----------------------------
    abstract class "_Function" [[expressions.html]] {
        __ element-wise over a matrix arg __
        mapMatrix(mv, f) : distributes f over dense elements
    }
    class "Exp" <<case>> [[expressions.html]] {
        e : _Expression
    }
    class "Ln" <<case>> [[expressions.html]] {
        e : _Expression   (natural log)
    }
    class "LogBase" <<case>> [[expressions.html]] {
        e : _Expression
        base : _Expression   (log(x)=LogBase(x,10))
    }
    class "Sin" <<case>> [[expressions.html]] {
        e : _Expression
    }
    class "Cos" <<case>> [[expressions.html]] {
        e : _Expression
    }
    class "Tg" <<case>> [[expressions.html]] {
        e : _Expression   (toString "tan")
    }
    class "Asin" <<case>> [[expressions.html]] {
        e : _Expression
    }
    class "Acos" <<case>> [[expressions.html]] {
        e : _Expression
    }
    class "Atan" <<case>> [[expressions.html]] {
        e : _Expression
    }

    ' -- Hyperbolic & reciprocal-trigonometric (issue 3.9) --
    class "Sinh / Cosh / Tanh" <<case>> [[expressions.html]] {
        e : _Expression   (hyperbolic)
    }
    class "Asinh / Acosh / Atanh" <<case>> [[expressions.html]] {
        e : _Expression   (inverse hyperbolic;
        complex arg stays symbolic)
    }
    class "Sec / Csc / Cot" <<case>> [[expressions.html]] {
        e : _Expression   (1/cos, 1/sin, cos/sin)
    }
    class "Sech / Csch / Coth" <<case>> [[expressions.html]] {
        e : _Expression   (reciprocal hyperbolic)
    }

    ' -- Special functions (issues 4.I / 4.K / 4.O) --
    class "Factorial / MultiFactorial" <<case>> [[expressions.html]] {
        fact(n) ; mfact(n,k) ; dfact=mfact(.,2)
    }
    class "Gamma / LogGamma / Digamma" <<case>> [[expressions.html]] {
        Gamma(z) (Greek Γ) ; lgamma ; digamma
    }
    class "Beta / BetaI" <<case>> [[expressions.html]] {
        Beta(a,b) (Greek β) ; betas(x,a,b)
    }
    class "Erf / Erfc" <<case>> [[expressions.html]] {
        erf(x) ; erfc(x) = Q(1/2, x^2)
    }
    class "GammaP / GammaQ" <<case>> [[expressions.html]] {
        regularised incomplete gamma P / Q
    }

    ' -- Special integral functions (issue 3.15) --
    class "Si / Ci / Ei / Li" <<case>> [[calculus.html]] {
        named antiderivatives of sin v/v,
        cos v/v, e^v/v, 1/ln v
        (Li prints "li"; Si/Ci/Ei reserved)
    }
    class "FresnelS / FresnelC" <<case>> [[calculus.html]] {
        ∫ sin/cos(π t²/2) dt
    }

    "_Function" --|> "_Expression"
    "Exp"    --|> "_Function"
    "Ln"     --|> "_Function"
    "LogBase" --|> "_Function"
    "Sin"    --|> "_Function"
    "Cos"    --|> "_Function"
    "Tg"     --|> "_Function"
    "Asin"   --|> "_Function"
    "Acos"   --|> "_Function"
    "Atan"   --|> "_Function"
    "Sinh / Cosh / Tanh"     --|> "_Function"
    "Asinh / Acosh / Atanh"  --|> "_Function"
    "Sec / Csc / Cot"        --|> "_Function"
    "Sech / Csch / Coth"     --|> "_Function"
    "Factorial / MultiFactorial" --|> "_Function"
    "Gamma / LogGamma / Digamma" --|> "_Function"
    "Beta / BetaI"           --|> "_Function"
    "Erf / Erfc"             --|> "_Function"
    "GammaP / GammaQ"        --|> "_Function"
    "Si / Ci / Ei / Li"      --|> "_Function"
    "FresnelS / FresnelC"    --|> "_Function"

    ' -- Functionals (higher-order) -----------------
    abstract class "_Functional" [[calculus.html]]

    class "_Derivative" <<case>> [[calculus.html]] {
        e : _Expression
        v : _Variable
    }
    class "_Integral" <<case>> [[calculus.html]] {
        e : _Expression
        v : _Variable
    }
    class "_DefIntegral" <<case>> [[calculus.html]] {
        e         : _Expression
        v         : _Variable
        low_limit : _Expression
        up_limit  : _Expression
    }
    class "_Limit" <<case>> [[calculus.html]] {
        e     : _Expression
        v     : _Variable
        point : _Expression
        dir   : LimitDir
    }

    enum "LimitDir" <<data>> [[calculus.html]] {
        Both
        FromRight
        FromLeft
    }

    class "_Taylor" <<case>> [[calculus.html]] {
        e, v (FREE, not a binder), point, n
        taylor(e,v,a,n) ; maclaurin = a 0
    }
    class "_FourierSeries" <<case>> [[calculus.html]] {
        e, v (free), period, n
        NUMERIC coeffs over [-T/2, T/2]
    }
    class "_Pade" <<case>> [[calculus.html]] {
        e, v (free), m, n
        [m/n] rational approximant about 0
    }
    class "_Laurent" <<case>> [[calculus.html]] {
        e, v (free), point, m (Option), n
        Σ(-m..n) c_k (v-a)^k ; 3.4
    }

    "_Functional"  --|> "_Expression"
    "_Derivative"  --|> "_Functional"
    "_Integral"    --|> "_Functional"
    "_DefIntegral" --|> "_Functional"
    "_Limit"       --|> "_Functional"
    "_Taylor"        --|> "_Functional"
    "_FourierSeries" --|> "_Functional"
    "_Pade"          --|> "_Functional"
    "_Laurent"       --|> "_Functional"

    ' -- Algorithm modules (package-level functions) -
    class "Limit" <<utility>> [[calculus.html]] {
        + evalLimit(e, v, point, dir, env): _Expression
        __ tiers __
        1. direct substitution
        2. L'Hopital (0/0, inf/inf, c/0)
        3. structural rules at +/-inf
        4. one-sided epsilon fallback
    }
    class "Derive" <<utility>> [[calculus.html]] {
        + derive(e, v): _Expression
        memoized (Memo)
    }
    class "Integrate" <<utility>> [[calculus.html]] {
        + integrate(e, v): _Expression
        __ dispatcher; tiers split by 2.6 __
        resolve(): compiled -> table -> substitution
        IntegrateParts      : by parts + power reductions
        IntegrateRational   : partial fractions
        IntegrateSubstitution: u-sub / trig-sub / Weierstrass
    }
    class "Simplify" <<utility>> [[expressions.html]] {
        + simplify(e): _Expression
        + simplifyFully(e): _Expression
        memoized (Memo)
    }
    class "Expand" <<utility>> [[expressions.html]] {
        + expand(e): _Expression
    }
    class "Normalize" <<utility>> [[equations.html]] {
        + collect(e, v): Option[Vector]
        + normalize(e, v): _Expression
    }
    class "Substitute" <<utility>> [[expressions.html]] {
        + substitute(e, defs): _Expression
    }
    class "Analysis" <<utility>> [[expressions.html]] {
        + dependsOn(e, v): Boolean
    }
    class "Compile" <<utility>> [[calculus.html]] {
        + compile(e, v, env): Option
    }
    class "Polynomial" <<utility>> [[equations.html]] {
        ~ polyDegree(cs): Int
        ~ derivCoeffs(cs): Vector
        ~ polyRoots(cs): Option[Vector]
        private[leonardo]; shared with transform
    }
    class "Sign" <<utility>> [[equations.html]] {
        ~ sign(e, env): Option[Int]
        ~ isNonZero / isNonNegative / isNonPositive
        decides the inequality direction flip
        private[leonardo]; shared with Domain
    }
    class "Domain" <<utility>> [[calculus.html]] {
        ~ domainOf(e, v, kind, env): DomainSet
        ~ differentiableDomainOf(...)
        ~ violatedAt(e, v, x, env): Option
        __ carrier __
        Requirement / Constraint / Interval
        DomainSet(constraints, intervals)
        neutral: rendered above the equation line
    }
    class "Singularity" <<utility>> [[calculus.html]] {
        ~ singularitiesOf(e, v, env): Option
        Removable | Pole(order)
        rational tier only
    }

    ' -- Base-conversion AST nodes (issue 3.5; eval -> core._Based) --
    class "_ToBase" <<case>> [[developer.html]] {
        e : _Expression
        base : _Expression   (tobase(n, b))
    }
    class "_Balanced" <<case>> [[developer.html]] {
        e : _Expression   (balanced(n); ternary {-1,0,1})
    }
    "_ToBase"   --|> "_Expression"
    "_Balanced" --|> "_Expression"
    "_ToBase"   ..> "_Based" : eval -> based value
    "_Balanced" ..> "_Based" : eval -> balanced-ternary value

    ' -- Rewrite engine (issue 6.21) + integral table content (3.7/3.8) --
    class "_Pattern" <<case>> [[developer.html]] {
        name : String   (a hole ?name)
        an _Expression only the unifier recognises
    }
    class "RewriteRule" <<data>> [[developer.html]] {
        lhs / rhs : _Expression
        condition : (bindings, contextVar) => Boolean
        guards: freeOf / isNumeric / nonZero / distinct
    }
    class "Rewrite" <<utility>> [[developer.html]] {
        + unify(pattern, e): Option[Map]
        + instantiate(rhs, bindings): _Expression
        + applyRules / rewriteFully  (cap 100 steps)
    }
    class "integralRules" <<object>> [[calculus.html]] {
        + applyTo(e, v): Option[_Expression]
        data-driven table of RewriteRules;
        ?v may bind a LINEAR a*x+b (chain rule)
    }
    "Rewrite" ..> "_Pattern"    : matches holes
    "Rewrite" ..> "RewriteRule" : rule set
    "integralRules" ..> "Rewrite"     : unify / instantiate
    "integralRules" ..> "RewriteRule" : the table entries
    "Integrate"     ..> "integralRules" : last-resort table (on give-up)
    "Integrate"     ..> "Substitute"    : freshVar / replaceSubexpr (u-sub, 3.10)

    ' -- Domain analysis carrier (issue 3.3; the neutral result Domain builds) --
    class "DomainSet" <<data>> [[calculus.html]] {
        constraints : Vector[Constraint]   (always)
        intervals   : Option[Vector[Interval]]
        None intervals = "not derivable" (not unbounded)
    }
    class "Constraint" <<data>> [[calculus.html]] {
        arg : _Expression
        requirement : Requirement
    }
    class "Interval" <<data>> [[calculus.html]] {
        lo / hi bounds, inclusivity
    }
    class "Singularity" <<data>> [[calculus.html]] {
        location : Double
        kind : SingularityKind
    }
    enum "Requirement" <<data>> [[calculus.html]] {
        Positive NonZero NonNegative
        InClosedUnit NotOddMultipleOfHalfPi
        NotNonPositiveInteger Never
    }
    enum "DomainKind" <<data>> [[calculus.html]] {
        Real   Complex
    }
    enum "SingularityKind" <<data>> [[calculus.html]] {
        Removable   Pole(order)
    }
    "Domain"      ..> "DomainSet"   : builds the neutral result
    "DomainSet"   ..> "Constraint"  : survives symbolic coeffs
    "DomainSet"   ..> "Interval"    : resolved numerically
    "Constraint"  ..> "Requirement"
    "Domain"      ..> "DomainKind"  : real / complex analysis
    "Singularity" ..> "SingularityKind"

    ' -- Remaining algorithm modules (package-level functions) --
    class "Series" <<utility>> [[calculus.html]] {
        + taylorSeries / maclaurinSeries(e,v,a,n)
        + fourierSeries(e,v,T,n,env)   (numeric)
        + padeApproximant(e,v,m,n,env)
    }
    class "Sample" <<utility>> [[calculus.html]] {
        + sample(e, v, lo, hi, n, env): Vector[(Double,Double)]
    }
    class "SpecialFunctions" <<utility>> [[developer.html]] {
        Double kernels (Option-returning):
        factorialOf / gammaOf / lgammaOf / betaOf
        erf / incomplete gamma & beta / digamma (4.O)
    }
    class "Memo" <<utility>> [[developer.html]] {
        bounded thread-safe cache
        backs derive / simplify
    }
    "_Taylor"        ..> "Series" : taylorSeries() at eval
    "_FourierSeries" ..> "Series" : fourierSeries() at eval
    "_Pade"          ..> "Series" : padeApproximant() at eval
    "_Laurent"       ..> "Series" : regularise + Taylor at eval
    "Series"   ..> "Derive"   : deriveN() coefficients
    "Derive"   ..> "Memo"
    "Simplify" ..> "Memo"
    "Factorial / MultiFactorial" ..> "SpecialFunctions" : Double kernels
    "Gamma / LogGamma / Digamma" ..> "SpecialFunctions"
    "Erf / Erfc"                 ..> "SpecialFunctions"

    ' -- Numeric sequences and the tabulator (issue 6.28) --
    class "_Sequence" <<case>> [[sequences.html]] {
        kind  : SeqKind
        n     : _Expression
        seeds : List (empty, or two overrides)
        x(k) = p*x(k-1) + q*x(k-2); ONE recurrence,
        the named variants are spellings of it
        (enum-tagged node, NOT parse-time aliases:
        sugar would lose the name on the way back)
        exact path past F(78), where a Double stops
        representing Fibonacci exactly
    }
    enum "SeqKind" <<data>> [[sequences.html]] {
        Fibonacci  (0,1) (1,1)
        Lucas      (2,1) (1,1)
        Pell       (0,1) (2,1)
        Jacobsthal (0,1) (1,2)
    }
    class "_Tabulate" <<case>> [[sequences.html]] {
        e, v (BINDER), lo, hi
        tabulate(e, k, lo, hi) -> 1 x n _Matrix
        generic: works for ANY expression, so every
        function gains a tabulated form from one node
    }
    class "Sequences" <<utility>> [[sequences.html]] {
        + linRecOf / linRecExact
        + binomOf / binomExact / catalan / harmonic
        two caps, as in SpecialFunctions
    }

    "_Sequence" --|> "_Expression"
    "_Tabulate" --|> "_Functional"
    "_Sequence" ..> "SeqKind"
    "_Sequence" ..> "Sequences" : linRec kernels at eval
    "_Tabulate" ..> "_Matrix"   : the row of terms

    class "Syntax" <<object>> [[expressions.html]] {
        simplify() / simplifyFully()
        expand()
        derive(v) / integrate(v)
        dependsOn(v) / substitute(defs)
        compile(v)
    }

    ' Dense-coefficient helpers shared by the rational tiers (issue 3.1)
    "Integrate" ..> "Polynomial" : degree / roots / d-dx
    "Integrate" ..> "Normalize"  : collect() poly coeffs

    ' Domain analysis (issue 3.3)
    "Domain"      ..> "Sign"       : interval sign chart
    "Domain"      ..> "Normalize"  : collect() constraint args
    "Domain"      ..> "Polynomial" : polyRoots() cut points
    "Domain"      ..> "Derive"     : differentiability
    "Singularity" ..> "Polynomial" : polyRoots() pole locations

    ' Functional nodes call algorithm modules at eval time
    "_Limit"       ..> "Limit"     : evalLimit() at eval
    "_Derivative"  ..> "Derive"    : derive() at eval
    "_Integral"    ..> "Integrate" : integrate() at eval
    "_DefIntegral" ..> "Compile"   : compile() fast path

    ' Syntax sugar delegates to each algorithm module
    "Syntax" ..> "Derive"     : delegates
    "Syntax" ..> "Integrate"  : delegates
    "Syntax" ..> "Simplify"   : delegates
    "Syntax" ..> "Expand"     : delegates
    "Syntax" ..> "Normalize"  : delegates
    "Syntax" ..> "Substitute" : delegates
    "Syntax" ..> "Analysis"   : delegates
    "Syntax" ..> "Compile"    : delegates
}

' ===================================================
' PACKAGE: matrix - matrix domain (imports core + scalar)
' ===================================================
package "matrix" {

    class "_Matrix" <<case>> [[matrix.html]] {
        exact entries do NOT collapse to _MatrixValue:
        this IS the exact matrix carrier (matrix/Exact.scala)
        + rows: Int
        + cols: Int
        + elems: Vector[_Expression]
        __ companion __
        + ofRows(rows*): _Matrix
        + fromValue(v): _Matrix
    }

    interface "_MatrixOperation" <<trait>> [[matrix.html]]

    class "MatSum" <<case>> [[matrix.html]] {
        a : _Expression
        b : _Expression
    }
    class "MatProduct" <<case>> [[matrix.html]] {
        a : _Expression
        b : _Expression
    }
    class "MatScale" <<case>> [[matrix.html]] {
        k : _Expression
        m : _Expression
    }
    class "Transpose" <<case>> [[matrix.html]] {
        m : _Expression
    }
    class "Inverse" <<case>> [[matrix.html]] {
        m : _Expression
        __ inv(A) ; drives 1/A __
        dense: Gauss-Jordan; symbolic: adjugate/det
    }

    class "Determinant" <<case>> [[matrix.html]] {
        m : _Expression
        __ det(A) : 1-based __
        returns SCALAR, not matrix
        dense: LU pivot; symbolic: cofactors
    }

    class "IdentityMatrix" <<case>> [[matrix.html]] {
        n : _Expression
        __ eye(n) __
        n×n matrix with 1s on diagonal
    }

    class "ZeroMatrix" <<case>> [[matrix.html]] {
        nRows : _Expression
        nCols : _Expression
        __ zeros(r, c) / zeros(n) __
        r×c matrix of 0.0
    }

    class "_LUDecomposition" <<case>> [[matrix.html]] {
        m : _Expression
        __ lu(A) → [[L, U, P]] __
        P·A = L·U; partial pivoting
        result: Left(_Matrix(1,3,...))
    }

    class "_QRDecomposition" <<case>> [[matrix.html]] {
        m : _Expression
        __ qr(A) → [[Q, R]] __
        A = Q·R; modified Gram-Schmidt
        result: Left(_Matrix(1,2,...))
    }

    class "_EigenDecomposition" <<case>> [[matrix.html]] {
        m : _Expression
        __ eigen(A) → [[λ₁, λ₂, …, λₙ]] __
        QR iteration + Wilkinson shifts
        real → _Number; complex pair → _Complex
        result: Left(_Matrix(1,n,...))
    }

    class "_EigDecomposition" <<case>> [[matrix.html]] {
        m : _Expression
        __ eig(A) → [[V, D]] __
        spectralDecompose: eigenvectors + D diagonal
        A·V = V·D; complex elems when needed
        result: Left(_Matrix(1,2,...))
    }

    class "_JordanDecomposition" <<case>> [[matrix.html]] {
        m : _Expression
        __ jordan(A) → [[P, J]] __
        A = P·J·P⁻¹ (diagonalizable matrices)
        defective → stays symbolic
        result: Left(_Matrix(1,2,...))
    }

    class "_MatrixIndex" <<case>> [[matrix.html]] {
        matrix : _Expression
        row    : _Expression
        col    : _Expression
        __ at(A, i, j) : 1-based __
        returns scalar element, not matrix
    }

    "_Matrix"          --|> "_Expression"
    "_MatrixOperation" --|> "_Expression"
    "MatSum"           --|> "_MatrixOperation"
    "MatProduct"       --|> "_MatrixOperation"
    "MatScale"         --|> "_MatrixOperation"
