              <y:UML stereotype="utility">
                <y:AttributeLabel>-- F_0141 --
declines a pole on or right of the axis
unless it cancels in the whole transform</y:AttributeLabel>
                <y:MethodLabel>+ fourierOf(e, t, w): _Expression
+ causalFourierOf(e, t, w): _Expression
+ fourierDecline(e, t, w, causal): Option[String]
L{x}(iw) + L{x(-t)}(-iw), each read on t &gt; 0</y:MethodLabel>
              </y:UML>
            </y:UMLClassNode>
          </data>
        </node>
