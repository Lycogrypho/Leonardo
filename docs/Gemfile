# Gemfile for the Leonardo documentation site (Just the Docs on GitHub Pages).
#
# Used by CI (ruby/setup-ruby with bundler-cache) and for local previews:
#
#   cd docs && bundle install
#   bundle exec jekyll serve --source ../target/mdoc --config _config.yml
#
# then browse http://127.0.0.1:4000/Leonardo/
#
# SOURCE IS ../target/mdoc -- mdoc's OUTPUT, not docs/src, its input.  Run `sbt docs/mdoc`
# first.  Pointing this at `src` is the mistake that broke the published site until
# 2026-08-23: kramdown rejects `scala mdoc:silent` as a language because of the colon, so
# every sample renders as a paragraph with the fence markers showing, and no evaluated result
# appears at all.  A preview built that way is misleading in exactly the places that matter.

source "https://rubygems.org"

gem "jekyll", "~> 4.3"
gem "jekyll-remote-theme", "~> 0.4"
gem "jekyll-relative-links", "~> 0.7"
gem "jekyll-seo-tag", "~> 2.8"

# REQUIRED BY THE THEME, and easy to miss.  Just the Docs declares
# `jekyll-include-cache` as a runtime dependency and its `_includes/head.html` uses the
# `{% include_cached %}` tag that gem provides -- but `remote_theme` only downloads the
# theme's FILES, never its gems, so nothing installs it on our behalf.  Without it every
# `jekyll build` dies with "Liquid Exception: Unknown tag 'include_cached'".
gem "jekyll-include-cache", "~> 0.2"

# Windows / JRuby time-zone data (harmless elsewhere).
gem "tzinfo-data", platforms: [:mingw, :x64_mingw, :mswin, :jruby]
