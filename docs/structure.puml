"Parser" ..> "_Solve"          : solve(eq | ineq, v)
"Parser" ..> "_SolveSystem"    : solveSystem(eqs, v...)
"Parser" ..> "_Taylor"         : taylor / maclaurin
"Parser" ..> "_FourierSeries"  : fourierSeries(e, v, T, n)
