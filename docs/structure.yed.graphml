            <y:UMLClassNode>
              <y:Geometry height="332.0" width="428.0" x="0.0" y="0.0"/>
              <y:Fill color="#E1ECFB" transparent="false"/>
              <y:BorderStyle color="#5B7FBF" type="line" width="1.0"/>
              <y:NodeLabel modelName="internal" modelPosition="c">Kleene</y:NodeLabel>
              <y:UML stereotype="utility">
                <y:AttributeLabel>_Bool -&gt; 1/0 ; _Truth -&gt; d
no graded value; digit 0 and _Membership are graded
-- kernels, curried on the semantics --
-- shared min-max rule table --
kleeneAnd = min ; kleeneOr = max
kleeneNot = 1 - a</y:AttributeLabel>
                <y:MethodLabel>+ asTruth(v, symmetric): Option[Double]
symmetric: also -1 / 0 / 1 (issue 4.G)
+ asDegree(v, symmetric): Option[Double]
wider: any number in [0,1] (membership domain)
+ isCrisp(e, symmetric): Boolean
kleeneAnd(s) = min / a*b / max(0,a+b-1)
kleeneOr(s)  = max / a+b-a*b / min(1,a+b)
kleeneNot    = 1 - a  (shared)
kleeneImplies(s), kleeneXor(s)
kleeneImplies = max(1 - a, b)
kleeneXor = max(min(a,1-b), min(1-a,b))</y:MethodLabel>
              </y:UML>
            </y:UMLClassNode>
          </data>
        </node>
        <node id="n6::n7">
          <data key="d1">https://lycogrypho.github.io/Leonardo/logic.html</data>
          <data key="d0">
