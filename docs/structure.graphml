    <node id="n8">
        <data key="n_label">_Truth</data>
        <data key="n_package">core</data>
        <data key="n_kind">class</data>
        <data key="n_stereotype">value</data>
        <data key="n_url">logic.html</data>
        <data key="n_members">+ d: Double   (strictly inside 0..1)
+ display(precision: Int): String
__ companion __
+ of(d): _Value  (0.0 -&gt; _Bool(false), 1.0 -&gt; _Bool(true))
Unknown: _Truth = _Truth(0.5)
+ fromSymmetric(s): _Value   t = (s + 1) / 2
+ toSymmetric(v): Option[Double]
display: &quot;unknown&quot; at 0.5, else &quot;truth(d)&quot;</data>
