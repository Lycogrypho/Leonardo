              <y:UML stereotype="utility">
                <y:AttributeLabel>-- rules --</y:AttributeLabel>
                <y:MethodLabel>+ laplaceOf(e, t, s): _Expression
constants, t^n, exp(ct)
sin(wt), cos(wt), linearity
first-shift e^{at}g(t) -&gt; G(s-a)
step u(t) -&gt; 1/s
2nd-shift u(t-a)g(t-a) -&gt; e^{-as}G(s)
deriv-of-xfm t^n*g(t) -&gt; (-1)^n d^n G/ds^n</y:MethodLabel>
              </y:UML>
            </y:UMLClassNode>
          </data>
        </node>
