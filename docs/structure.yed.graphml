              <y:NodeLabel modelName="internal" modelPosition="c">InverseLaplaceTransform</y:NodeLabel>
              <y:UML stereotype="utility">
                <y:AttributeLabel>multiplicities from squareFreeFactors
numerators by undetermined coefficients
repeated irreducible quadratic, k &gt;= 3: declined
-- second-shift --</y:AttributeLabel>
                <y:MethodLabel>+ inverseLaplaceOf(f, s, t): _Expression
-- rational N(s)/D(s), deg D = 1 or 2 --
linearity, b/(s-a) -&gt; b*e^{at}
partial fractions (distinct roots)
repeated + complex poles (complete the square)
-- deg D &gt;= 3, repeated poles included (3.17) --
A/(s-r)^k -&gt; A t^(k-1) e^(rt) / (k-1)!
e^{-as}*F(s) -&gt; u(t-a)*f(t-a)</y:MethodLabel>
              </y:UML>
            </y:UMLClassNode>
          </data>
        </node>
