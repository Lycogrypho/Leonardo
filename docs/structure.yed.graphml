              <y:NodeLabel modelName="internal" modelPosition="c">SolveODESymbolic</y:NodeLabel>
              <y:UML stereotype="utility">
                <y:AttributeLabel>-- constant-coeff linear y' = a*y + b --
integrating factor mu = e^{-integral a dt}</y:AttributeLabel>
                <y:MethodLabel>+ solveODESymbolic(...): Option[_Expression]
a*y      -&gt; y0*e^{a(t-t0)}
b        -&gt; y0 + b*(t-t0)
a*y + b  -&gt; (y0 + b/a)*e^{a(t-t0)} - b/a
-- variable-coeff linear y' = a(t)*y + b(t) --
y = (Q(target) - Q(t0) + y0*mu(t0)) / mu(target)
with Q = integral(mu*b dt)</y:MethodLabel>
              </y:UML>
            </y:UMLClassNode>
          </data>
        </node>
