' ===================================================
' PACKAGE: vector - vector calculus (imports core + scalar + matrix)
' a field is an n x 1 matrix._Matrix, NOT a new carrier
' ===================================================
package "vector" {

    interface "_VectorOperator" <<trait>> [[calculus.html]] {
        e      : _Expression
        coords : Vector[_Variable]   (ORDERED; free in
                 the result, never substituted --
                 the _Taylor convention, not a binder)
        system : CoordinateSystem
        componentsOf(): reads a LITERAL matrix without
          evaluating -- evaluating first would collapse
          symbolic cells to constants once the
          coordinates happen to be bound
        __ one formula set, scale-factor driven (6.26) __
        scaleFactors: (1,1,1) | (1,r,1) | (1,r,r sin t)
        grad_i = (1/h_i) df/dq_i
        div    = (1/J) sum d/dq_i (J/h_i * F_i)
        curl_i = (1/h_j h_k)[d(h_k F_k)/dq_j - d(h_j F_j)/dq_k]
          times handedness (+1 / -1): the formula
          assumes a RIGHT-handed ordering, and only
          curl (a pseudo-vector) reads the sign
        Cartesian is the h = 1 case
    }

    class "_Grad" <<case>> [[calculus.html]] {
        grad(f, x..) -> n x 1
    }
    class "_Div" <<case>> [[calculus.html]] {
        div(F, x..) -> SCALAR
        needs one component per coordinate
    }
    class "_Curl" <<case>> [[calculus.html]] {
        curl(F, x, y, z) -> 3 x 1
        3-D ONLY; 2-D curl is a scalar,
        a different result type -> refused
    }
    class "_Laplacian" <<case>> [[calculus.html]] {
        laplacian(f, x..) -> SCALAR
        DEFINED as div(grad(f)), so the
        two can never disagree
    }
    class "_Jacobian" <<case>> [[calculus.html]] {
        jacobian(F, x..) -> m x n
    }
    class "_Hessian" <<case>> [[calculus.html]] {
        hessian(f, x..) -> n x n (symmetric)
    }

    enum "CoordinateSystem" <<data>> [[calculus.html]] {
        Cartesian      (x, y, ..) h = (1, 1, 1)
        Cylindrical    (r, t, z)  h = (1, r, 1)
        Spherical      (r, t, p)  h = (1, r, r sin t)
        SphericalMaths (r, t, p)  h = (1, r sin p, r)
        3-D only for the curvilinear ones;
        coordinates identified BY POSITION, so the
        two spherical cases differ in argument
        ORDER (t polar vs p polar), not in naming.
        The swap flips handedness -> curl negates
    }

    "_VectorOperator" --|> "_Expression"
    "_Grad"      --|> "_VectorOperator"
    "_Div"       --|> "_VectorOperator"
    "_Curl"      --|> "_VectorOperator"
    "_Laplacian" --|> "_VectorOperator"
    "_Jacobian"  --|> "_VectorOperator"
    "_Hessian"   --|> "_VectorOperator"

    "_VectorOperator" ..> "CoordinateSystem"
    "_VectorOperator" ..> "Derive"    : every operator is a composition of derive()
    "_VectorOperator" ..> "_Matrix"   : field carrier (n x 1) and matrix results
    "_Laplacian"      ..> "_Div"      : div(grad(f))
    "_Laplacian"      ..> "_Grad"
}

' ===================================================
' PACKAGE: control - control theory (6.29)
' imports core + scalar + matrix + transform; a LEAF, nothing imports it
' A transfer function is an ordinary Ratio -- NO carrier type (Decision A),
' so every entry point takes the frequency variable EXPLICITLY
' ===================================================
package "control" {

    class "TransferFunction" <<object>> [[control.html]] {
        series / parallel / feedback (v explicit)
        feedback is NEGATIVE: G/(1 + G*H)
        __ coeffsOf: the single coefficient view __
        rationalCoeffs + polyGcd cancellation, so
          feedback(1/(s(s+2)), 1) has poles {-1,-1}
          and NOT the uncancelled {0,-2,-1,-1}
        gcd quotients are VERIFIED (float gcd);
          an ill-conditioned one leaves it unreduced
        poles / zeros -> Option[Vector[_Value]]
          _Value, not Double: a complex pole is the
          INTERESTING case, not an error
        isStable: from the POLES, not Routh -- Routh's
          degenerate cases give a wrong verdict
          rather than a refusal.  STRICT, so
          marginal stability is not stability
        isStableDiscrete: UNIT CIRCLE, not LHP
        routhTable / dcgain
        bode / nyquist: one substitution s -> i*w
          on the existing _Complex closure
    }

    class "_Series"          <<case>> [[control.html]]
    class "_Parallel"        <<case>> [[control.html]]
    class "_Feedback"        <<case>> [[control.html]]
    class "_StepResponse"    <<case>> [[control.html]] {
        step(G, s, t) = invlaplace(G/s)
        arity overload: step(x) is Heaviside
        DECLINES an improper G (impulse at t=0)
    }
    class "_ImpulseResponse" <<case>> [[control.html]]

    class "StateSpace" <<object>> [[control.html]] {
        stateSpace(A,B,C,D) -> 1 x 4 _Matrix
          the lu/qr/eig shape: at(m,1,k) and :save
          come free, no new carrier
        controllable(A, B) via ctrb + full row rank
        observable(A, C) = controllable(A', C')
          DEFINED by duality, never restated
        c2dExact(A, B, Ts): expm([[A,B],[0,0]]*Ts)
          NOT A^-1 (A_d - I) B -- the block form is
          defined for a SINGULAR A, and any system
          with an integrator has one
    }

    enum "DiscretisationMethod" <<data>> [[control.html]] {
        Zoh    -- what sampled-data hardware does
        Tustin -- bilinear, exactly invertible
        ALWAYS an explicit argument: the two give
        DIFFERENT discrete poles
    }

    class "Discretisation" <<object>> [[control.html]] {
        c2d: Tustin = substitution;
             Zoh = step response -> sample -> ztrans
             -> (1 - z^-1) factor   [needs 6.33]
        d2c: Tustin only; a Zoh inverse needs a
             matrix logarithm -> declined
    }

    "_Series"          --|> "_Expression"
    "_Parallel"        --|> "_Expression"
    "_Feedback"        --|> "_Expression"
    "_StepResponse"    --|> "_Expression"
    "_ImpulseResponse" --|> "_Expression"

    "TransferFunction" ..> "rationalCoeffs" : one fraction, then cancel
    "_StepResponse"    ..> "InverseLaplaceTransform" : 3.17, re-spelled
    "Discretisation"   ..> "ZTransform"     : 6.33 is the ZOH prerequisite
    "Discretisation"   ..> "TransferFunction" : normaliseTf (single definition)
    "StateSpace"       ..> "_MatrixValue"   : expm (6.39)
}

